{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "PoleSafe",
    "slug": "polesafe",
    "scheme": "polesafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ug.polesafe.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PoleSafe needs your location to track rides and show nearby drivers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PoleSafe needs background location for live ride tracking.",
        "NSCameraUsageDescription": "PoleSafe uses the camera for driver verification photos and safe word photos.",
        "NSMicrophoneUsageDescription": "PoleSafe uses the microphone for voice features.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "ug.polesafe.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-camera"
    ],
    "extra": {
      "apiUrl": "https://polesafe-api.onrender.com",
      "eas": {
        "projectId": "98b4f44f-96a1-4d05-9050-8a140c800839"
      }
    },
    "owner": "musaayi",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/98b4f44f-96a1-4d05-9050-8a140c800839"
    }
  }
}
