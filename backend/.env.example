# PoleSafe Backend Configuration
# Copy this file to .env and fill in your values
# Environment variables override config.js defaults

# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/polesafe

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Flutterwave (payments)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxx
FLUTTERWAVE_LIVE=false

# Africa's Talking (SMS)
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_SHORTCODE=your-shortcode
AT_SENDER_ID=PoleSafe

# Twilio (WhatsApp) — optional, AT WhatsApp also supported
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google Maps (for tracking/distance calculation)
GOOGLE_MAPS_API_KEY=your-gmaps-api-key

# Firebase Cloud Messaging (push notifications) — optional
FCM_SERVER_KEY=your-fcm-server-key

# GitHub Pages (for docs)
GITHUB_TOKEN=your-github-token
