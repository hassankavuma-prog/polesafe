# ============================================================
# POLE SAFE — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# ============================================================

# ---- Server ----
PORT=3000

# ---- Database ----
# MongoDB Atlas (cloud): mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/polesafe
# Local: mongodb://localhost:27017/polesafe
MONGODB_URI=mongodb://localhost:27017/polesafe

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ---- 📱 Africa's Talking (SMS) ----
# Sign up: https://africastalking.com
# Price: ~35 UGX/SMS (~$0.009)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
SMS_SHORTCODE=27700

# ---- 💬 WhatsApp Business API ----
# Choose one provider:
#   wati — https://wati.io (~$50/mo starter, popular in Uganda)
#   africastalking — same Africa's Talking account (~$0.05/conversation)
#   twilio — https://twilio.com (~$0.05/conversation)
WHATSAPP_PROVIDER=wati
WHATSAPP_API_KEY=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE=+256700000000

# ---- 💳 Flutterwave (Payments) ----
# Sign up: https://dashboard.flutterwave.com/register
# Momo fees: ~0.8% per tx (negotiable to 0.4-0.5% at volume)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_LIVE=false

# ---- 🗺️ Google Maps API ----
# Sign up: https://console.cloud.google.com
# Enable: Geocoding API, Distance Matrix API, Directions API, Places API
# Free credit: $200/month (covers launch)
GOOGLE_MAPS_API_KEY=

# ---- 📧 Email ----
# sendgrid — 100 emails/day free (https://sendgrid.com)
# mailgun — 5,000/month free (https://mailgun.com)
# smtp — your own mail server
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=receipts@polesafe.ug
EMAIL_FROM_NAME=PoleSafe Receipts
EMAIL_API_KEY=
# SMTP (if using smtp provider)
EMAIL_SMTP_HOST=smtp.polesafe.ug
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
